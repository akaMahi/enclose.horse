# Godot 4+ specific ignores
.godot/
/android/

# Web build outputs — regenerated by CI (see github/workflows/godot-web.yml),
# so they don't need to be committed. This also avoids github.com's 25 MB
# browser-upload limit (index.wasm is ~39 MB). Comment these out if you
# deploy manually by pushing the github/ folder contents to a gh-pages branch.
github/index.wasm
github/index.pck
github/index.js
github/index.audio.worklet.js
github/index.audio.position.worklet.js
.DS_Store